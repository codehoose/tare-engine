<Window x:Class="TareEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TareEditor"
        xmlns:views="clr-namespace:TareEditor.Views"
        mc:Ignorable="d"
        Title="TareEditor" Height="600" Width="900">
    <DockPanel>
        <!-- Placeholder toolbar - Phase 7 replaces this with the real menu/toolbar
             (New/Open/Save/Import/Export). Kept here only so Phase 4's node
             canvas is reachable for manual testing before then. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
            <Button Content="Add Room" Padding="8,2" Command="{Binding CurrentMap.AddRoomCommand}" />
        </StackPanel>

        <views:MapCanvasView DataContext="{Binding CurrentMap}" />
    </DockPanel>
</Window>
