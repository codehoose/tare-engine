<UserControl x:Class="TareEditor.Views.RoomNodeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Width="160" Height="90">
    <Canvas Width="160" Height="90">
        <Border x:Name="Body"
                Canvas.Left="0" Canvas.Top="0" Width="160" Height="90"
                Background="#FFF5F0DC" BorderBrush="Black" BorderThickness="1" CornerRadius="4"
                Cursor="SizeAll"
                MouseLeftButtonDown="Body_MouseLeftButtonDown"
                MouseMove="Body_MouseMove"
                MouseLeftButtonUp="Body_MouseLeftButtonUp"
                LostMouseCapture="Body_LostMouseCapture">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BorderBrush" Value="#FF3070E0" />
                            <Setter Property="BorderThickness" Value="2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Margin="6" IsHitTestVisible="False">
                <TextBlock Text="{Binding Slug}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Short}" FontSize="10" TextWrapping="Wrap" Opacity="0.75" />
            </StackPanel>
        </Border>

        <!-- Compass/vertical exit ports. Positioned in code-behind from
             RoomNodeGeometry (shared with the connector-line geometry), not
             here in XAML, so the two can't drift apart. Dragging from a port
             starts a new connection (Phase 5); clicking one just marks the
             event handled so it never falls through to Body's node-drag. -->
        <Ellipse x:Name="NorthPort" Tag="North" ToolTip="North" Width="12" Height="12"
                 Fill="#FFB0B0B0" Stroke="Black"
                 MouseLeftButtonDown="Port_MouseLeftButtonDown" MouseMove="Port_MouseMove"
                 MouseLeftButtonUp="Port_MouseLeftButtonUp" LostMouseCapture="Port_LostMouseCapture" />
        <Ellipse x:Name="SouthPort" Tag="South" ToolTip="South" Width="12" Height="12"
                 Fill="#FFB0B0B0" Stroke="Black"
                 MouseLeftButtonDown="Port_MouseLeftButtonDown" MouseMove="Port_MouseMove"
                 MouseLeftButtonUp="Port_MouseLeftButtonUp" LostMouseCapture="Port_LostMouseCapture" />
        <Ellipse x:Name="EastPort" Tag="East" ToolTip="East" Width="12" Height="12"
                 Fill="#FFB0B0B0" Stroke="Black"
                 MouseLeftButtonDown="Port_MouseLeftButtonDown" MouseMove="Port_MouseMove"
                 MouseLeftButtonUp="Port_MouseLeftButtonUp" LostMouseCapture="Port_LostMouseCapture" />
        <Ellipse x:Name="WestPort" Tag="West" ToolTip="West" Width="12" Height="12"
                 Fill="#FFB0B0B0" Stroke="Black"
                 MouseLeftButtonDown="Port_MouseLeftButtonDown" MouseMove="Port_MouseMove"
                 MouseLeftButtonUp="Port_MouseLeftButtonUp" LostMouseCapture="Port_LostMouseCapture" />
        <Ellipse x:Name="UpPort" Tag="Up" ToolTip="Up" Width="10" Height="10"
                 Fill="#FFA0C8F0" Stroke="Black"
                 MouseLeftButtonDown="Port_MouseLeftButtonDown" MouseMove="Port_MouseMove"
                 MouseLeftButtonUp="Port_MouseLeftButtonUp" LostMouseCapture="Port_LostMouseCapture" />
        <Ellipse x:Name="DownPort" Tag="Down" ToolTip="Down" Width="10" Height="10"
                 Fill="#FFA0C8F0" Stroke="Black"
                 MouseLeftButtonDown="Port_MouseLeftButtonDown" MouseMove="Port_MouseMove"
                 MouseLeftButtonUp="Port_MouseLeftButtonUp" LostMouseCapture="Port_LostMouseCapture" />
    </Canvas>
</UserControl>
