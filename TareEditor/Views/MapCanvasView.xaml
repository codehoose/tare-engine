<UserControl x:Class="TareEditor.Views.MapCanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TareEditor.ViewModels"
             xmlns:views="clr-namespace:TareEditor.Views"
             xmlns:converters="clr-namespace:TareEditor.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:ExitLineConverter x:Key="ExitLineConverter" />
        <converters:PendingConnectionConverter x:Key="PendingConnectionConverter" />
    </UserControl.Resources>

    <!-- Named so RoomNodeControl (a different UserControl, nested inside the
         Rooms ItemsControl below) can find it by walking up the visual tree
         and measure drag positions relative to it - see RoomNodeControl.xaml.cs.
         This is also the element Phase 6 will apply the zoom/pan
         RenderTransform to, so it's the right "canvas space" reference both
         now (identity) and later. -->
    <Grid x:Name="CanvasRoot" Background="#FFEAEAEA" ClipToBounds="True"
          MouseLeftButtonDown="CanvasRoot_MouseLeftButtonDown">

        <!-- Exit connection lines, beneath the room nodes. -->
        <ItemsControl ItemsSource="{Binding AllExits}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ExitViewModel}">
                    <Grid>
                        <!-- Wide transparent stroke: the real (thin) line is
                             hard to click precisely, so this is the actual
                             hit-test target for selection/removal. Renders as
                             nothing when Target is null (Geometry.Empty). -->
                        <Path x:Name="HitPath" Stroke="Transparent" StrokeThickness="14"
                              MouseLeftButtonDown="ExitHitArea_MouseLeftButtonDown">
                            <Path.Data>
                                <MultiBinding Converter="{StaticResource ExitLineConverter}">
                                    <Binding Path="Source.X" />
                                    <Binding Path="Source.Y" />
                                    <Binding Path="Target.X" />
                                    <Binding Path="Target.Y" />
                                    <Binding Path="Source" />
                                    <Binding Path="Target" />
                                    <Binding Path="Direction" />
                                </MultiBinding>
                            </Path.Data>
                            <Path.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Remove exit" Click="RemoveExitMenuItem_Click" />
                                </ContextMenu>
                            </Path.ContextMenu>
                        </Path>
                        <Path Data="{Binding ElementName=HitPath, Path=Data}" IsHitTestVisible="False">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="#FF404040" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="#FF3070E0" />
                                            <Setter Property="StrokeThickness" Value="3" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Room nodes. -->
        <ItemsControl ItemsSource="{Binding Rooms}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RoomViewModel}">
                    <views:RoomNodeControl />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Rubber-band line while dragging a new connection from a port. -->
        <Path IsHitTestVisible="False" Stroke="#FF3070E0" StrokeThickness="2" StrokeDashArray="4 2">
            <Path.Data>
                <MultiBinding Converter="{StaticResource PendingConnectionConverter}">
                    <Binding Path="IsConnectingExit" />
                    <Binding Path="PendingSourceRoom" />
                    <Binding Path="PendingSourceDirection" />
                    <Binding Path="PendingConnectionEnd" />
                </MultiBinding>
            </Path.Data>
        </Path>
    </Grid>
</UserControl>
